# Data-generation and maintenance image.
#
# Phase 13. Separate from the API image on purpose: seeding needs the scripts,
# the dataset generators and pytest, none of which should ship in a container
# that serves public requests. The API image stays minimal; this one does not
# have to.
#
# Build from the PROJECT ROOT:
#     docker build -f docker/Dockerfile.tools -t text2sql-tools .

FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONPATH=/app

WORKDIR /app

COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

COPY src/ ./src/
COPY scripts/ ./scripts/
COPY dataset/ ./dataset/
COPY database/ ./database/
COPY tests/ ./tests/

RUN useradd --create-home --uid 10001 appuser && chown -R appuser:appuser /app
USER appuser

CMD ["python", "scripts/generate_data.py"]
