# ---------------------------------------------------------------------
# Copy this file to .env and fill in real values.
#
#   PowerShell:  Copy-Item .env.example .env
#
# .env is git-ignored and MUST NEVER be committed.
# This file (.env.example) is committed and must contain placeholders only.
# ---------------------------------------------------------------------

# --- PostgreSQL connection ---
PGHOST=localhost
PGPORT=5432
PGDATABASE=enterprise_sql

# Superuser — used only to CREATE the database and the application role.
PGSUPERUSER=postgres
PGSUPERPASSWORD=your_postgres_password_here

# Application user — what the pipeline uses day to day.
# Deliberately separate from the superuser: the Text-to-SQL system executes
# model-generated SQL, and a model must never hold rights to DROP a table.
APP_DB_USER=texttosql_app
APP_DB_PASSWORD=choose_a_strong_password

# --- Phase 4: model inference ---
# Hugging Face access token, used to reach Qwen3-8B via HF Inference Providers.
# Create one at https://huggingface.co/settings/tokens with "Make calls to
# Inference Providers" permission. A read-scoped fine-grained token is enough.
#
# Never paste this into a chat, a commit, or a script. It belongs only here,
# and .env is git-ignored.
HF_TOKEN=hf_your_token_here

# --- Phase 13/14: deployment ---
# TLS mode for the database connection. Local PostgreSQL has no certificate, so
# "prefer" (libpq's default) is right for development. Managed Postgres — Neon,
# Supabase, RDS — refuses plaintext, so set this to "require" when deploying.
PGSSLMODE=prefer

# --- Phase 14: publishing to the Hugging Face Hub ---
# Deliberately SEPARATE from HF_TOKEN above. HF_TOKEN only needs inference
# permission; publishing needs write. Keeping them apart means an inference
# credential can never push to a repository.
# Create at https://huggingface.co/settings/tokens -> New token -> Write
HF_WRITE_TOKEN=hf_your_write_token_here
